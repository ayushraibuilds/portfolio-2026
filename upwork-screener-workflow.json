            "id": "fetch-rss-5",
            "name": "Fetch: FastAPI AI",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                700
            ]
        },
        {
            "parameters": {
                "jsCode": "// Combine all RSS feed responses and extract jobs\nconst items = $input.all();\nconst allJobs = [];\nconst seen = new Set();\n\nfor (const item of items) {\n  const xml = item.json.data || item.json.body || '';\n  \n  // Simple XML parsing for RSS items\n  const itemRegex = /<item>(.*?)<\\/item>/gs;\n  let match;\n  \n  while ((match = itemRegex.exec(xml)) !== null) {\n    const itemXml = match[1];\n    \n    const getTag = (tag) => {\n      const r = new RegExp(`<${tag}[^>]*><!\\\\[CDATA\\\\[(.+?)\\\\]\\\\]><\\\\/${tag}>|<${tag}[^>]*>(.+?)<\\\\/${tag}>`, 's');\n      const m = itemXml.match(r);\n      return m ? (m[1] || m[2] || '').trim() : '';\n    };\n    \n    const title = getTag('title');\n    const link = getTag('link');\n    const description = getTag('description')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/&amp;/g, '&')\n      .replace(/&lt;/g, '<')\n      .replace(/&gt;/g, '>')\n      .replace(/&quot;/g, '\"')\n      .replace(/\\s+/g, ' ')\n      .trim();\n    const pubDate = getTag('pubDate');\n    \n    // Extract budget if present\n    const budgetMatch = description.match(/Budget:\\s*\\$([\\d,]+)/i) || \n                         description.match(/Hourly Range:\\s*\\$([\\d.]+)-\\$([\\d.]+)/i);\n    const budget = budgetMatch ? budgetMatch[0] : 'Not specified';\n    \n    if (link && !seen.has(link)) {\n      seen.add(link);\n      allJobs.push({\n        title,\n        link,\n        description: description.substring(0, 1000),\n        pubDate,\n        budget,\n        fetchedAt: new Date().toISOString()\n      });\n    }\n  }\n}\n\nreturn allJobs.map(job => ({ json: job }));"
            },
            "id": "parse-all-rss",
            "name": "Parse & Deduplicate RSS",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                700,
                300
            ]
        },
