        {
            "parameters": {
                "jsCode": "// Parse the AI scoring response\nconst aiResponse = $input.first().json;\nconst originalJob = $('Filter New Jobs Only').first().json;\nlet parsed;\n\ntry {\n  const rawText = aiResponse.text || aiResponse.output || JSON.stringify(aiResponse);\n  const cleaned = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    total_score: 0,\n    skill_match: 0,\n    project_proof: 0,\n    rate_fit: 0,\n    red_flags: 0,\n    matching_projects: [],\n    verdict: 'SKIP',\n    reason: 'Could not parse AI response'\n  };\n}\n\nreturn [{\n  json: {\n    ...originalJob,\n    ...parsed,\n    date: new Date().toISOString().split('T')[0]\n  }\n}];"
            },
