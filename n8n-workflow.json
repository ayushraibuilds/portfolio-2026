                        {
                            "id": "filter-no-auto-reply",
                            "leftValue": "={{ $json.from }}",
                            "rightValue": "ayushraibuilds@gmail.com",
                            "operator": {
                                "type": "string",
                                "operation": "notEquals"
                            }
                        }
                    ]
                }
            },
            "id": "filter-spam",
            "name": "Filter Spam & Auto-Replies",
            "type": "n8n-nodes-base.filter",
            "typeVersion": 2,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "modelId": {
                    "__rl": true,
                    "value": "gemini-2.0-flash",
                    "mode": "list"
                },
                "messages": {
                    "values": [
                        {
                            "content": "You are Ayush Rai's AI assistant. Ayush is an AI Agent Developer & Automation Engineer based in Bengaluru.\n\nHis services and pricing:\n1. WhatsApp AI Agents (LangGraph + Groq Whisper + Twilio) — starting $150 (₹12,000)\n2. AI SaaS Tools (Next.js + FastAPI + Supabase) — starting $250 (₹20,000)\n3. Workflow Automation (n8n, Zapier, Make) — starting $50 (₹5,000)\n4. RAG / Knowledge Systems — custom pricing\n5. Full-Stack Web Development — custom pricing\n\nHis top projects (reference these when relevant):\n- TenderPilot AI: RFP auto-filler with Chrome extension (React + Node + vector search)\n- D2C Voice Agent: WhatsApp voice AI for D2C brands (FastAPI + LangGraph + Groq Whisper)\n- Invosmith: AI GST-compliant invoice generator (Next.js + Gemini + Groq)\n- SastaBot: WhatsApp price comparison bot across 5 platforms (FastAPI + LangGraph + Redis)\n- ONDC Super Seller: B2B seller dashboard for ONDC network (Next.js + FastAPI + Supabase)\n\nAyush has 17+ shipped production projects, is Meta-Certified, and has a B.E. in ECE.\n\nAnalyze the incoming email and respond with ONLY valid JSON (no markdown, no code fences):\n{\n  \"sender_name\": \"extracted name or 'Unknown'\",\n  \"service_interest\": \"whatsapp_agent | ai_saas | automation | rag | webdev | general | other\",\n  \"urgency\": \"high | medium | low\",\n  \"summary\": \"one-line summary of what they want\",\n  \"reply\": \"A warm, professional reply (2-3 paragraphs max). Thank them for reaching out. Briefly mention how you can help based on their need — reference 1-2 relevant projects from the list above. Ask 1-2 clarifying questions. Sign off as Ayush Rai. Do NOT invent pricing not listed above. Keep it conversational and friendly.\"\n}"
                        },
                        {
                            "content": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\n\nEmail body:\n{{ $json.textPlain || $json.snippet || 'No body content' }}"
                        }
                    ]
                },
                "options": {
                    "temperature": 0.7,
                    "maxOutputTokens": 1024
                }
            },
            "id": "ai-classify-reply",
            "name": "AI: Classify & Draft Reply",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                640,
                300
            ],
            "credentials": {
                "googleGeminiApi": {
                    "id": "REPLACE_WITH_YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Parse the AI response JSON\nconst aiResponse = $input.first().json;\nlet parsed;\n\ntry {\n  const rawText = aiResponse.text || aiResponse.output || JSON.stringify(aiResponse);\n  const cleaned = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    sender_name: 'Unknown',\n    service_interest: 'general',\n    urgency: 'medium',\n    summary: 'Could not parse - manual review needed',\n    reply: 'Hi there,\\n\\nThank you for reaching out! I\\'ve received your message and will get back to you shortly with more details.\\n\\nBest regards,\\nAyush Rai\\nAI Solutions Expert'\n  };\n}\n\nconst originalEmail = $('Filter Spam & Auto-Replies').first().json;\n\nreturn [{\n  json: {\n    ...parsed,\n    original_from: originalEmail.from,\n    original_subject: originalEmail.subject,\n    original_email: originalEmail.from.match(/<(.+)>/) ? originalEmail.from.match(/<(.+)>/)[1] : originalEmail.from,\n    date: new Date().toISOString().split('T')[0],\n    timestamp: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })\n  }\n}];"
            },
            "id": "parse-ai-response",
            "name": "Parse AI Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                860,
                300
            ]
        },
        {
            "parameters": {
                "sendTo": "={{ $json.original_email }}",
                "subject": "=Re: {{ $('Filter Spam & Auto-Replies').first().json.subject }}",
                "message": "={{ $json.reply }}",
                "options": {
                    "replyTo": "ayushraibuilds@gmail.com",
                    "appendAttribution": false
                }
            },
            "id": "send-reply",
            "name": "Send AI Reply",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2.1,
            "position": [
                1080,
                200
            ],
            "credentials": {
                "gmailOAuth2": {
                    "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
                    "name": "Gmail - ayushraibuilds"
                }
            }
        },
        {
